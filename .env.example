# Copy to .env and fill in. Blank values switch that channel off.
# Comments go on their own line: text after a value would become part of the value.

# Trial mode: the bot drafts every message for you to review in /admin and sends nothing to customers.
# Only switch to false after the live test and the trial review (see README).
TRIAL_MODE=true

# Claude (https://console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Where this service is reachable on the internet (used for webhook signatures and dashboard links)
PUBLIC_BASE_URL=https://sales.echolight.ae
DATABASE_PATH=/data/salesbot.db
TIMEZONE=Asia/Dubai

# Dashboard password (open /admin, any username). Prices are entered only there.
ADMIN_TOKEN=

# Owner alerts: price needed, reminders, voice notes, bookings, escalations, daily digest
OWNER_EMAIL=
# Your PERSONAL WhatsApp for alerts, not the business number the bot runs on
OWNER_WHATSAPP=

# Meta app (WhatsApp + Instagram webhooks)
META_APP_SECRET=
# Any random string; paste the same value in the Meta webhook settings
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# WhatsApp Cloud API
# Permanent System User token
WHATSAPP_TOKEN=
# The Cloud API id of +971 56 722 0533
WHATSAPP_PHONE_NUMBER_ID=
# Approved message templates (names), used when the customer last wrote more than 24h ago. Wording: README.
WA_TEMPLATE_FOLLOWUP=
WA_TEMPLATE_MISSED_CALL=
WA_TEMPLATE_REVIEW=
WA_TEMPLATE_REACTIVATION=
WA_TEMPLATE_QUOTE_READY=
WA_TEMPLATE_OWNER_ALERT=
# Arabic-speaking customers always get the Arabic templates; everyone else gets this language.
# Set to en once your English templates are approved.
WA_TEMPLATE_DEFAULT_LANGUAGE=ar

# Instagram (professional account linked to the Meta app)
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_TOKEN=
# A comment gets a private reply only if the whole comment is one of these words, or it asks the price
INSTAGRAM_COMMENT_KEYWORDS=عرض,سعر,price,quote,info

# Email: outgoing SMTP, plus a token for the inbound webhook URL
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=sales@echolight.ae
EMAIL_INBOUND_TOKEN=

# Phone (Twilio number). Leave CALL_FORWARD_NUMBER blank to skip ringing the team.
TWILIO_AUTH_TOKEN=
CALL_FORWARD_NUMBER=

# Website chat: sites allowed to embed the widget
WEBCHAT_ALLOWED_ORIGINS=https://www.echolight.ae,https://echolight.ae

# Timing (hours unless stated)
FOLLOWUP_DELAYS_HOURS=20,72,168
PRICE_REMINDER_HOURS=3,24
# After those, remind every N hours until the lead is priced (0 = stop)
PRICE_REMINDER_REPEAT_HOURS=24
TRIAL_ALERT_MINUTES=30
QUOTE_VALIDITY_DAYS=7
REVIEW_DELAY_HOURS=24
REACTIVATION_DELAY_DAYS=60
DIGEST_HOUR=9
